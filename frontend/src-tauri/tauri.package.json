{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AI Video Studio",
  "version": "0.1.0",
  "identifier": "vn.studio.aivideo",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AI Video Studio",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "shortDescription": "Local-first AI video authoring studio",
    "category": "Video",
    "externalBin": [
      "binaries/studio-ffmpeg",
      "binaries/studio-ffprobe"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "resources": {
      "../../licenses/": "licenses/"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0t64",
          "libavdevice62",
          "libavfilter11",
          "libavformat62",
          "libavcodec62",
          "libavutil60",
          "libswscale9",
          "libswresample6"
        ]
      }
    }
  }
}